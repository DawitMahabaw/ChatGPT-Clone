# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Required in production. Use a long, unique random value.
JWT_SECRET=replace_with_a_long_unique_random_secret

# Database Configuration (MySQL)
# Use these credentials to connect to your MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=chatgpt_clone
# Optional: local hosts default to no SSL; remote database hosts default to SSL.
DB_SSL=false
# For verified remote TLS, provide one of:
# DB_SSL_CA=<full PEM CA certificate contents>
# DB_SSL_CA_PATH=<path to a PEM CA certificate file available at runtime>

# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro

# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================

# Backend API URL
# For development: http://localhost:5000/api
# For production: https://your-backend-url.vercel.app/api
VITE_API_URL=http://localhost:5000/api

# ============================================
# DEPLOYMENT CONFIGURATION (OPTIONAL)
# ============================================

# Vercel Deployment
# Set these if deploying to Vercel
VERCEL_ENV=development

# CORS Configuration (if needed)
# CORS_ORIGIN=http://localhost:5173
